# QColorPrefs.exe saved preferences
# Generated automatically - do not edit unless you know what you're doing
# Registry path: HKEY_CURRENT_USER\Software\Marcus Aurelius Software LLC\QSPICE\[Preferences]
# Section filter: [waveform] only
#
# This is a Matlab dark theme provided by forum member @KSKelvin
# 12 trace colors, waveform settings only
#
# Install this theme with:
#    QColorPrefs -rwav MatLab_Dark
#

[waveform]
NumberDataTraceColors=12     # Number of Trace Colors
CursorBackFore=0xffffff      # Attached Cursor Text Color
CursorBackGnd=0x0000ff       # Attached Cursor Background
CursorLineColor=0xc8c8c8     # Cursor Color
FrameColor=0xc8c8c8          # Ticks & Axis Color
BackgroundColor=0x000000     # Background Color
WaveFormViewerFontPoints=120 # not a color but relevant
WaveformPlotLineWidth=2.5    # not a color but relevant
DataColor1=0x00ff00          # Waveform Trace #1 Color
DataColor2=0xff3f00          # Waveform Trace #2 Color
DataColor3=0x003fff          # Waveform Trace #3 Color
DataColor4=0x008000          # Waveform Trace #4 Color
DataColor5=0x807f00          # Waveform Trace #5 Color
DataColor6=0x007f80          # Waveform Trace #6 Color
DataColor7=0xffff00          # Waveform Trace #7 Color
DataColor8=0xff00bf          # Waveform Trace #8 Color
DataColor9=0x9314ff          # Waveform Trace #9 Color
DataColor10=0x0080ff         # Waveform Trace #10 Color
DataColor11=0x00ffff         # Waveform Trace #11 Color
DataColor12=0xffffff         # Waveform Trace #12 Color
DataColor13=0x00ff00         # Waveform Trace #13 Color
DataColor14=0xff3f00         # Waveform Trace #14 Color
DataColor15=0x003fff         # Waveform Trace #15 Color
DataColor16=0x008000         # Waveform Trace #16 Color
DataColor17=0x807f00         # Waveform Trace #17 Color
DataColor18=0x007f80         # Waveform Trace #18 Color
DataColor19=0x00ff00         # Waveform Trace #19 Color
DataColor20=0xff3f00         # Waveform Trace #20 Color
DataColor21=0x003fff         # Waveform Trace #21 Color
DataColor22=0x008000         # Waveform Trace #22 Color
DataColor23=0x807f00         # Waveform Trace #23 Color
DataColor24=0x007f80         # Waveform Trace #24 Color

