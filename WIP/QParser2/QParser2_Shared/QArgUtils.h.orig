/*
 * Classes for argument values.  The idea is that we start with basic types that
 * can later be derived to more descriptive types.  For example, we might have
 * an argument that initially we recognize as a float (ArgFloat).  Later in the
 * reverse-engineering we might discover that it's a font size.  At that point,
 * we can derive an ArgFontSize class that specializes for font-size-specific
 * functionality....
 */

#pragma once
#include <iomanip>
#include <iostream>
#include <regex>
#include <sstream>
#include <stdexcept>
#include <string>

struct Point {
  int xVal;
  int yVal;

  Point() : xVal(0), yVal(0) {}
  Point(int x_, int y_) : xVal(x_), yVal(y_) {}

  // Add another point to this point and return result
  Point add(const Point &other) const {
    return Point(xVal + other.xVal, yVal + other.yVal);
  }

  // Operator overload for addition
  Point operator+(const Point &other) const {
    return Point(xVal + other.xVal, yVal + other.yVal);
  }

  // Add another point to this point (modifies this point)
  Point &operator+=(const Point &other) {
    xVal += other.xVal;
    yVal += other.yVal;
    return *this;
  }
};

class ArgInt {
public:
  int value = 0;

  ArgInt(int val = 0) { value = val; }
  ArgInt(std::string str) { parse(str); }
  ~ArgInt() {};

  static inline int parse(const std::string &str) {
    try {
      size_t pos;
      int value = std::stoi(str, &pos);
      // Check if entire string was consumed
      if (pos != str.length()) {
        throw std::invalid_argument("Invalid integer format");
      }
      return value;
    } catch ([[maybe_unused]] const std::exception &e) {
      throw std::invalid_argument("Failed to parse integer: " + str);
    }
  }

  std::string toString() const { return ArgInt::toString(value); }

  static inline std::string toString(int val) { return std::to_string(val); }
};

class ArgFloat {
public:
  static inline float parse(const std::string &str) {
    try {
      size_t pos;
      float value = std::stof(str, &pos);
      if (pos != str.length()) {
        throw std::invalid_argument("Invalid float format");
      }
      return value;
    } catch ([[maybe_unused]] const std::exception &e) {
      throw std::invalid_argument("Failed to parse float: " + str);
    }
  }

  static inline std::string toString(float value, int precision = 6) {
    std::ostringstream oss;
    oss << std::fixed << std::setprecision(precision) << value;
    return oss.str();
  }
};

class ArgHex {
public:
  static inline int parse(const std::string &str) {
    try {
      // Ensure string starts with "0x" or "0X"
      if (str.length() < 3 ||
          (str.substr(0, 2) != "0x" && str.substr(0, 2) != "0X")) {
        throw std::invalid_argument("Hex string must start with 0x");
      }

      size_t pos;
      int value = std::stoi(str, &pos, 16);
      if (pos != str.length()) {
        throw std::invalid_argument("Invalid hex format");
      }
      return value;
    } catch ([[maybe_unused]] const std::exception &e) {
      throw std::invalid_argument("Failed to parse hex: " + str);
    }
  }

  static inline std::string toString(int value, int width = 8) {
    std::ostringstream oss;
    oss << "0x" << std::setfill('0') << std::setw(width) << std::hex
        << std::uppercase << value;
    return oss.str();
  }
};

class ArgBool {
public:
  static inline bool parse(const std::string &str) {
    if (str == "true") return true;
    if (str == "false") return false;
    throw std::invalid_argument("Failed to parse bool: " + str);
  }

  static inline std::string toString(bool value) {
    if (value) return "true";
    return "false";
  }
};

class ArgPoint {
public:
  static inline Point parse(const std::string &str) {
    // Pattern matches: optional whitespace, '(', optional whitespace,
    // integer (with optional sign), optional whitespace, ',',
    // optional whitespace, integer (with optional sign),
    // optional whitespace, ')'
    // static const std::regex
    // pattern(R"(\s*\(\s*(-?\d+)\s*,\s*(-?\d+)\s*\)\s*)");

    // Pattern matches: '(', integer (with optional sign), ',',
    // integer (with optional sign), ')' - NO whitespace allowed
    static const std::regex pattern(R"(\((-?\d+),(-?\d+)\))");
    std::smatch matches;

    if (!std::regex_match(str, matches, pattern)) {
      throw std::invalid_argument("Invalid point format: " + str);
    }

    try {
      int x = std::stoi(matches[1].str());
      int y = std::stoi(matches[2].str());
      return Point(x, y);
    } catch ([[maybe_unused]] const std::exception &e) {
      throw std::invalid_argument("Failed to parse point values: " + str);
    }
  }

  static inline std::string toString(const Point &point) {
    std::ostringstream oss;
    oss << "(" << point.xVal << "," << point.yVal << ")";
    return oss.str();
  }
};

