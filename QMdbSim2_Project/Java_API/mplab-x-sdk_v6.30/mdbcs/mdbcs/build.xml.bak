<?xml version="1.0" encoding="UTF-8"?>
<project name="mdbcs" default="default" basedir=".">
    <description>Builds, tests, and runs the project mdbcs.</description>
    <import file="nbproject/build-impl.xml"/>

    <!--
        -post-jar: runs automatically after the standard NetBeans jar target.

        Produces dist/qmdbcs.jar as a fat JAR containing:
          - All MDBCS classes from dist/mdbcs.jar (Debugger, Pin, PinImpl, etc.)
          - QMdbCS.class (our JNI facade, compiled from QMdbCS.java in this source tree)

        dist/mdbcs.jar is still produced by the standard target and is left intact.
        C++ loads only qmdbcs.jar; mdbcs.jar is no longer referenced at runtime.

        MdbConfig.ini key: QMdbcsJar=<path>\dist\qmdbcs.jar
    -->
    <target name="-post-jar">

        <!-- Temp directory for unpacking mdbcs.jar contents -->
        <property name="qmdbcs.unpack.dir" value="${build.dir}/qmdbcs-unpack"/>

        <delete dir="${qmdbcs.unpack.dir}"/>
        <mkdir  dir="${qmdbcs.unpack.dir}"/>

        <!-- Unpack the standard mdbcs.jar (Debugger, Pin, PinImpl, MException, etc.) -->
        <unzip src="${dist.jar}" dest="${qmdbcs.unpack.dir}"/>

        <!-- Overlay QMdbCS.class from the normal compile output.
             QMdbCS.java lives in src/com/microchip/mdbcs/ alongside Debugger.java,
             so its class lands in build/classes/com/microchip/mdbcs/QMdbCS.class. -->
        <copy todir="${qmdbcs.unpack.dir}" overwrite="true">
            <fileset dir="${build.classes.dir}">
                <include name="com/microchip/mdbcs/QMdbCS.class"/>
            </fileset>
        </copy>

        <!-- Repack into dist/qmdbcs.jar with the same manifest as mdbcs.jar -->
        <jar destfile="${dist.dir}/qmdbcs.jar"
             basedir="${qmdbcs.unpack.dir}"
             manifest="${build.dir}/MANIFEST.MF">
        </jar>
<!-- No manifest needed: JAR is loaded programmatically by C++, not via java -jar -->
        <jar destfile="${dist.dir}/qmdbcs.jar"
             basedir="${qmdbcs.unpack.dir}">
        </jar>
        <echo message="Built: ${dist.dir}/qmdbcs.jar (fat JAR, includes QMdbCS facade)"/>

    </target>

</project>
