B RB0 AN3/PGA2P3/CMP1D/CMP2B/RP32
B RB1 OSC1/CLKI/AN6/RP33
B RB2 OSC2/CLKO/AN7/PGA1N2/RP34
B RB3 PGED2/AN8/INT0/RP35
